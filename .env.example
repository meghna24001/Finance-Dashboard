# Copy this file to .env and fill in real values. .env is never uploaded to
# GitHub or shared (see .gitignore) - it's how secrets stay off your screen
# recordings and out of your code.
#
# Locally, you don't need a .env file at all: the app already has safe
# defaults for developing on your own computer.

# Turns on the online settings: secure cookies, no auto-created tables,
# and a required SECRET_KEY. See DEPLOY.md.
APP_ENV=production

# A long random secret used to keep people signed in securely. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this value, never commit it, and use a different one for every
# app you deploy.
SECRET_KEY=

# Where your data lives online. On PythonAnywhere, an absolute path to a
# SQLite file (note the 4 slashes):
DATABASE_URL=sqlite:////home/yourusername/finance-dashboard/instance/finance.db
# For a PostgreSQL database instead, it looks like:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Only set this to 1 on a host that puts a real proxy in front of your app
# and forwards who the visitor really is (Render, Railway, Fly.io, ...).
# Leave it unset on PythonAnywhere.
# TRUST_PROXY=1

# On PythonAnywhere, this tells the app which header carries the visitor's
# real address, so login attempts are limited per person, not per server.
CLIENT_IP_HEADER=X-Real-IP
